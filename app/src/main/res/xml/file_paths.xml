<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Diagnostic log only. Notes, audio, and models stay private. -->
    <files-path
        name="logs"
        path="logs/" />
    <!-- M4A share copies. The original WAV stays in private files. -->
    <cache-path
        name="shared_audio"
        path="share/" />
    <!-- Bug-report JPEG copies and a snapshot of the diagnostic log. -->
    <cache-path
        name="bugreport"
        path="bugreport/" />
</paths>
