<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/widget_mic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/widget_mic_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mic_glow" />

        <FrameLayout
            android:id="@+id/widget_mic_plate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/widget_mic_plate"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/widget_mic_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_mic"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mic" />

            <ImageView
                android:id="@+id/widget_mic_done"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_mic"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_done"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_text_block"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/widget_words_out"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:ellipsize="none"
            android:fontFamily="@font/manrope_500"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="4"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_words"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="none"
            android:fontFamily="@font/manrope_500"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="4"
            android:text="@string/widget_live_off"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
