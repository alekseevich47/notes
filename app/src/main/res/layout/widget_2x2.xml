<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingTop="2dp"
    android:paddingEnd="3dp"
    android:paddingBottom="1dp">

    <FrameLayout
        android:id="@+id/widget_mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/widget_mic_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mic_glow" />

        <FrameLayout
            android:id="@+id/widget_mic_plate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/widget_mic_plate"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/widget_mic_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_mic"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mic" />

            <ImageView
                android:id="@+id/widget_mic_done"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_mic"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_done"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_500"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
